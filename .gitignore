# Runtime storage (Keep structure via .gitkeep, ignore runtime files)
storage/uploads/*
!storage/uploads/.gitkeep
storage/outputs/*
!storage/outputs/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/assets/*
!storage/assets/.gitkeep
storage/backups/*
!storage/backups/.gitkeep

# Legacy / Accidental storage
apps/storage/
apps/api/storage/
apps/web/dist/
tmp/
scratch/
